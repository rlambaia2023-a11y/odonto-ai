# Corretor de provas OdontoAI: só a tela Streamlit + src/grading (leve, sem RAG).
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-corretor.txt .
RUN pip install --no-cache-dir -r requirements-corretor.txt
COPY src ./src
COPY frontend ./frontend
COPY examples ./examples
COPY start-corretor.sh ./
RUN useradd --create-home app && chown -R app /app
USER app
# Railway/Render informam a porta do site em $PORT; o bot usa BOT_PORT (8081)
CMD ["sh", "start-corretor.sh"]
