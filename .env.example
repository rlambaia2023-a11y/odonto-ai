# LLM provider: openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store
CHROMA_PATH=./data/chroma

# Ingestion
PUBMED_QUERY=(dentistry OR odontology OR "oral health") AND (clinical OR treatment OR diagnosis)
PUBMED_MAX_RESULTS=50
GUIDELINE_FEEDS=https://www.ada.org/rss,https://www.who.int/rss-feeds/news-english.xml
UPDATE_HOUR=3

# Correção de provas
GRADING_MODEL_ANTHROPIC=claude-opus-5-5
GRADING_EFFORT=high
GRADING_MODEL_OPENAI=gpt-4o
GRADING_MAX_WORKERS=8
GRADING_MIN_CONFIDENCE=0.7
