# LLM provider: openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store
CHROMA_PATH=./data/chroma

# Ingestion
PUBMED_QUERY=(dentistry OR odontology OR "oral health") AND (clinical OR treatment OR diagnosis)
PUBMED_MAX_RESULTS=50
GUIDELINE_FEEDS=https://www.ada.org/rss,https://www.who.int/rss-feeds/news-english.xml
UPDATE_HOUR=3
