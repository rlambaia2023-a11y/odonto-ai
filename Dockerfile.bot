# Bot do corretor (Telegram + WhatsApp): mesma base leve do corretor, sem o site Streamlit.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-corretor.txt .
RUN pip install --no-cache-dir -r requirements-corretor.txt
COPY src ./src
RUN useradd --create-home app && chown -R app /app
USER app
# Railway informa a porta em $PORT
CMD uvicorn src.bot.app:app --host 0.0.0.0 --port ${PORT:-8081} --no-access-log
